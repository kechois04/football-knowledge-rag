# ========================================================
# Variables d'Environnement - Projet RAG Football
# ========================================================
# Copiez ce fichier en '.env' et complétez avec vos clés :
# cp .env.example .env

# Clé API Groq (Obligatoire pour les LLM Qwen / GPT-OSS)
# Obtenez une clé gratuite sur : https://console.groq.com/keys
GROQ_API_KEY=votre_cle_groq_ici

# Configuration de la base de données Neo4j (Docker)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=football2024

# Clé API Football-Data.org (Obligatoire pour les données temps réel)
# Obtenez une clé gratuite sur : https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=votre_cle_football_data_ici
